{
  // AI Office 中継 Worker（P2）: スマホ⇄Mac の指示/状態を1つの Room DO で中継する。
  // ローカル検証: npx wrangler dev --port 8788 （miniflare・ログイン不要・月¥0）
  // 本番デプロイ: wrangler login → wrangler secret put RELAY_TOKEN → wrangler deploy
  "name": "ai-office-relay",
  "main": "src/worker.js",
  // 2026-07-30: 5秒ポーリングがCF無料枠を食い潰し一時閉鎖（workers_dev=false）。
  // 2026-07-31 R50提案4で再開: /sync統合（1周1リクエスト）＋変化時のみpush＋在席適応interval
  // ＋relay_agent側のinterval床（config由来は15秒未満不可・既定60）＝試算で無料枠の5-8%。
  "workers_dev": true,
  "compatibility_date": "2025-01-01",
  // R80-C7: Workers Logs の無料枠は 200,000イベント/日。100%サンプリングだと
  // 異常系（再接続ループ等）が起きたときログ側も道連れで枯れる。10%で足りる。
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
